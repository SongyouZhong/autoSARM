# ===========================================
# AutoSARM Service - Environment Variables
# ===========================================
# Copy this file to .env and modify as needed
#   cp .env.example .env

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=mydatabase

# ===========================================
# SeaweedFS Storage Configuration
# ===========================================
SEAWEED_FILER_ENDPOINT=http://host.docker.internal:8888
SEAWEED_BUCKET=astramolecula

# ===========================================
# Task Processor Configuration
# ===========================================
POLL_INTERVAL=30

# ===========================================
# Application Configuration
# ===========================================
LOG_LEVEL=INFO
TEMP_DIR=/tmp/autosarm

# ===========================================
# Docker Image Tag
# ===========================================
IMAGE_TAG=latest

# ===========================================
# Worker Port Mapping (host ports)
# ===========================================
SARM_PORT_1=8030
SARM_PORT_2=8031
SARM_PORT_3=8032
